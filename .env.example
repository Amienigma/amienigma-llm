# Server-only. Export these locally or set them in your hosting environment.
# This file is documentation only; never commit real keys or use VITE_ for secrets.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional OpenRouter attribution URL:
OPENROUTER_SITE_URL=
# Still required for images/video; chat fallback when no OpenRouter key is set:
XAI_API_KEY=
XAI_MODEL=grok-4.5
# Optional extra chat providers. They activate only when the matching key exists.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
